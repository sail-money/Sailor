# Sailor project .gitignore — real values and secrets are never committed; the
# public, CI-required files are explicitly re-included at the bottom.

# Dependencies & TypeScript build output
node_modules/
dist/
*.tsbuildinfo

# Foundry build outputs
out/
cache/
broadcast/

# Environment — never commit real secrets
.env
.env.*
!.env.example

# Sail runtime state and encrypted keys
.sail/keys/
.sail/runtime/
.sail/state/
.sail/.env.local
.sail/.wizard-state.json
.sail/account.json
.sail/mandate.json
.sail/mandate-draft.json
.sail/activity.jsonl

# Committed on purpose: public config plus the files `sailor run` needs at
# startup (only public addresses and flags, no secrets) so agent-tick CI works.
!.sail/.gitkeep
!.sail/config.json
!.sail/account.json
!.sail/mandate.json

# CI keystore — encrypted agent wallet, safe to commit.
# Generated by `sailor keys export-ci`; unlocked in CI with SAIL_PASSPHRASE.
!ci-keystore.json
