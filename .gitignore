node_modules/

# Package manager / local tooling
.pnpm-store/
.yarn/
!.yarn/releases/
!.yarn/plugins/
!.yarn/sdks/
!.yarn/versions/

# Test and build outputs
*dist*
coverage/
out/
cache/
broadcast/
.vite/
.vitest/
*.tsbuildinfo
packages/ui/test-results/
scaffold/.skeleton-check/

# Environment — never commit real secrets
.env
.env.*
!.env.example

# Sail local runtime state and encrypted keys
**/.sail/keys/
**/.sail/runtime/
**/.sail/state/
**/.sail/.env.local
**/.sail/.wizard-state.json
**/.sail/account.json
**/.sail/mandate.json
**/.sail/mandate-draft.json
**/.sail/activity.jsonl

# Sandbox state root — the whole directory, unlike .sail/ above. Nothing in
# .shipyard/ is ever authored: the sandbox creates all of it at runtime (SMA
# record, .env.local, anvil logs, multi-MB chain-state dumps) and archives
# whole worlds into _reset-backup-<timestamp>/ directories whose names cannot
# be enumerated in advance. .sail/ needs a per-file list only because the
# scaffold tracks a README and config.json there; .shipyard/ has no such
# content, so a per-file list here would only leave gaps.
**/.shipyard/

# OS / editors
.DS_Store
.idea/
.vscode/

# Local agent-tooling settings
.claude/
