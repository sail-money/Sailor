{
  "name": "sailor",
  "version": "2.0.0",
  "description": "The Sailor CLI — the harness for building and operating DeFi agents on Sail Protocol",
  "type": "module",
  "bin": {
    "sailor": "./dist/index.cjs"
  },
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./commands/init": {
      "import": "./dist/commands/init.js",
      "types": "./dist/commands/init.d.ts"
    }
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.cjs --external:bufferutil --external:utf-8-validate --external:tsx && esbuild ../ui/server.js --bundle --platform=node --format=cjs --outfile=dist/server.cjs --external:bufferutil --external:utf-8-validate",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sail/sdk": "workspace:*",
    "commander": "^12.0.0",
    "tsx": "^4.22.4",
    "viem": "^2.21.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0"
  }
}
