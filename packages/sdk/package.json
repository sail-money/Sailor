{
  "name": "@sail/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Sailor — the Sail Protocol operator toolkit",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./templates": {
      "import": "./dist/templates/index.js",
      "types": "./dist/templates/index.d.ts"
    },
    "./safe": {
      "import": "./dist/safe.js",
      "types": "./dist/safe.d.ts"
    },
    "./deployments": {
      "import": "./dist/deployments.js",
      "types": "./dist/deployments.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "viem": "^2.21.0"
  }
}
