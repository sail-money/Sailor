{
  "name": "@sail/sdk",
  "version": "0.0.1",
  "description": "TypeScript SDK for Sail Protocol — SailorClient, dispatch signing, EIP-712 helpers, deployment registry. Pre-1.0/unstable.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./templates": {
      "import": "./dist/templates/index.js",
      "types": "./dist/templates/index.d.ts"
    },
    "./safe": {
      "import": "./dist/safe.js",
      "types": "./dist/safe.d.ts"
    },
    "./accounts": {
      "import": "./dist/accounts.js",
      "types": "./dist/accounts.d.ts"
    },
    "./eip712": {
      "import": "./dist/eip712.js",
      "types": "./dist/eip712.d.ts"
    },
    "./deployments": {
      "import": "./dist/deployments.js",
      "types": "./dist/deployments.d.ts"
    },
    "./chains": {
      "import": "./dist/chains.js",
      "types": "./dist/chains.d.ts"
    },
    "./abis": {
      "import": "./dist/abis/index.js",
      "types": "./dist/abis/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "sail",
    "sail-protocol",
    "defi",
    "eip712",
    "safe",
    "sma",
    "viem",
    "ethereum"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sail-money/Sailor.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://sail.money",
  "bugs": {
    "url": "https://github.com/sail-money/Sailor/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "name": "@sail.money/sdk",
    "access": "public"
  },
  "scripts": {
    "prebuild": "node scripts/generate-intelligence.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "generate:intelligence": "node scripts/generate-intelligence.mjs"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "viem": "^2.21.0"
  }
}
