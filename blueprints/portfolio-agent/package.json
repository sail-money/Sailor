{
  "name": "portfolio-agent",
  "version": "0.1.0",
  "description": "Sailor portfolio agent: DCA + rebalance a weighted token basket toward global target weights across chains",
  "type": "module",
  "scripts": {
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dashboard": "node dashboard/server.mjs",
    "settle": "scripts/run-until-settled.sh manual",
    "dashboard:start": "node -e \"const {spawn}=require('child_process');const fs=require('fs');fs.mkdirSync('.sail/runtime',{recursive:true});const out=fs.openSync('.sail/runtime/dashboard.log','a');const c=spawn(process.execPath,['dashboard/server.mjs'],{detached:true,stdio:['ignore',out,out]});c.unref();console.log('dashboard starting (pid '+c.pid+') -> http://localhost:'+(process.env.DASHBOARD_PORT||4123))\"",
    "dashboard:stop": "node -e \"const fs=require('fs');try{const {pid}=JSON.parse(fs.readFileSync('.sail/runtime/dashboard.json','utf8'));process.kill(pid,'SIGTERM');console.log('stopped dashboard pid '+pid)}catch(e){console.log('dashboard not running')}\"",
    "dashboard:status": "node -e \"const fs=require('fs');try{const s=JSON.parse(fs.readFileSync('.sail/runtime/dashboard.json','utf8'));process.kill(s.pid,0);console.log('running  http://localhost:'+s.port+'  (pid '+s.pid+', since '+s.startedAt+')')}catch(e){console.log('stopped')}\""
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@sail.money/sailor": "^2.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.5.0"
  }
}
