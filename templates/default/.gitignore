node_modules/
dist/
*.tsbuildinfo

# Environment — never commit real secrets
.env
.env.*
!.env.example

# Sail runtime state and encrypted keys
.sail/keys/
.sail/runtime/
.sail/state/
.sail/.env.local
.sail/.wizard-state.json
.sail/account.json
.sail/mandate.json
.sail/mandate-draft.json
.sail/activity.jsonl
!.sail/.gitkeep
!.sail/config.json

# CI keystore — encrypted agent wallet, safe to commit
# Generated by `sailor keys export-ci`; unlocked in CI with SAIL_PASSPHRASE
!ci-keystore.json

# sailor run needs these at startup; they contain only public addresses and
# flags (no secrets) and must be committed for CI to work.
!.sail/account.json
!.sail/mandate.json
